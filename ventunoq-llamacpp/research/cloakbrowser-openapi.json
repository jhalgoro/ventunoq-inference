{"openapi":"3.1.0","info":{"title":"CloakBrowser Manager","version":"0.1.0"},"paths":{"/api/auth/status":{"get":{"summary":"Auth Status","description":"Check if auth is enabled and if the current request is authenticated.\n\nExempt from auth middleware so the frontend can always call it.","operationId":"auth_status_api_auth_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/auth/login":{"post":{"summary":"Auth Login","operationId":"auth_login_api_auth_login_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/auth/logout":{"post":{"summary":"Auth Logout","operationId":"auth_logout_api_auth_logout_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/profiles":{"get":{"summary":"List Profiles","operationId":"list_profiles_api_profiles_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"items":{"$ref":"#/components/schemas/ProfileResponse"},"type":"array","title":"Response List Profiles Api Profiles Get"}}}}}},"post":{"summary":"Create Profile","operationId":"create_profile_api_profiles_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfileCreate"}}},"required":true},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfileResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/test-proxy":{"post":{"summary":"Test Proxy Endpoint","description":"Connect through a proxy and report exit IP + geo + latency.","operationId":"test_proxy_endpoint_api_profiles_test_proxy_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProxyTestRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProxyTestResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/reorder":{"post":{"summary":"Reorder Profiles","operationId":"reorder_profiles_api_profiles_reorder_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReorderRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}":{"get":{"summary":"Get Profile","operationId":"get_profile_api_profiles__profile_id__get","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfileResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"put":{"summary":"Update Profile","operationId":"update_profile_api_profiles__profile_id__put","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfileUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfileResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Delete Profile","operationId":"delete_profile_api_profiles__profile_id__delete","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/reset":{"post":{"summary":"Reset Profile","description":"Reset a profile: stop browser, wipe state files, re-roll fingerprint seed.\n\nPreserves bookmarks, preferences and all profile settings (name, proxy, tags,\netc.). Returns the updated (stopped) profile — the frontend re-launches it.","operationId":"reset_profile_api_profiles__profile_id__reset_post","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfileResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/duplicate":{"post":{"summary":"Duplicate Profile","description":"Clone a profile into a new profile (name suffixed ' (copy)').\n\nSettings, tags, notes and the same fingerprint seed are always copied. With\n``include_browser_state`` the source's user_data_dir (cookies, logged-in\nsessions, history) is copied too, so the clone launches as the same identity\nand the same session. Without it (the default) the clone gets a fresh, empty\nuser_data_dir.\n\nThe state copy is a consistent snapshot: the source is held stopped for the\nwhole copy (launch / reset / delete of it are refused meanwhile), and the\nclone's row is written only after its directory is complete, so a half-built\nclone is never listed, launched or deleted.","operationId":"duplicate_profile_api_profiles__profile_id__duplicate_post","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/ProfileDuplicateRequest"},{"type":"null"}],"title":"Req"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfileResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/files":{"get":{"summary":"List Profile Files","description":"Files attached to a profile — uploaded in, or downloaded by its browser.","operationId":"list_profile_files_api_profiles__profile_id__files_get","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ArtifactResponse"},"title":"Response List Profile Files Api Profiles  Profile Id  Files Get"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"summary":"Upload Profile File","description":"Store the request body as a file of the profile; returns its id and in-container path.\n\nThe body is the file itself, streamed straight into the profile's store: one copy on\ndisk, nothing buffered ahead of the size check. ``X-File-Name`` carries the name,\nURL-encoded. The path returned is what a CDP call (``DOM.setFileInputFiles``,\n``Input.dispatchDragEvent``) hands to the page; uploading does not by itself select the\nfile in any input.","operationId":"upload_profile_file_api_profiles__profile_id__files_post","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/files/{artifact_id}":{"get":{"summary":"Download Profile File","description":"Serve an artifact's bytes.\n\nAlways an attachment of an opaque type: these files come from merchant portals, and\nrendering one inline on the Manager's own origin would be a needless script-execution path.","operationId":"download_profile_file_api_profiles__profile_id__files__artifact_id__get","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}},{"name":"artifact_id","in":"path","required":true,"schema":{"type":"string","title":"Artifact Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Delete Profile File","description":"Remove an artifact. Row first, then bytes — same order as profile deletion, so a\nfailure leaves an unreferenced file (reclaimed with the profile) rather than a dead row.","operationId":"delete_profile_file_api_profiles__profile_id__files__artifact_id__delete","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}},{"name":"artifact_id","in":"path","required":true,"schema":{"type":"string","title":"Artifact Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/launch":{"post":{"summary":"Launch Profile","operationId":"launch_profile_api_profiles__profile_id__launch_post","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LaunchResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/stop":{"post":{"summary":"Stop Profile","operationId":"stop_profile_api_profiles__profile_id__stop_post","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/status":{"get":{"summary":"Get Profile Status","operationId":"get_profile_status_api_profiles__profile_id__status_get","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfileStatusResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/health":{"get":{"summary":"Health Check","description":"Unauthenticated liveness probe for the Docker healthcheck.\n\nIntentionally returns no system details; see /api/status (auth-gated)\nfor running counts and versions.","operationId":"health_check_api_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/status":{"get":{"summary":"Get System Status","operationId":"get_system_status_api_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StatusResponse"}}}}}}},"/api/open-external":{"post":{"summary":"Open External","description":"Open an http(s) URL in the host's default browser. The native app runs\ninside a pywebview/WKWebView window where JS `window.open` is a no-op, so the\nfrontend routes external links through here. The server is local in native\nmode, so this launches the user's own browser.","operationId":"open_external_api_open_external_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Payload"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/update-check":{"get":{"summary":"Check For Update","description":"Report whether a newer Manager release exists on GitHub. Fail-soft +\ncached (6h) so it never hammers GitHub or errors the caller.","operationId":"check_for_update_api_update_check_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateCheckResponse"}}}}}}},"/api/shutdown":{"post":{"summary":"Shutdown Manager","description":"Stop the Manager: graceful uvicorn shutdown → lifespan closes every\nrunning browser (cleanup_all) → the process exits. Lets the user quit from\nthe UI so no orphaned server is left behind.\n\nCSRF-guarded: a bodyless POST is a CORS simple request (no preflight), so\nwithout this any site the user visits could kill the Manager via a no-cors\nfetch. Reject when a browser Origin is present and doesn't match Host.","operationId":"shutdown_manager_api_shutdown_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/settings":{"get":{"summary":"Get Settings","operationId":"get_settings_api_settings_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SettingsResponse"}}}}}},"put":{"summary":"Update Settings","description":"Persist license key / release channel and hot-apply without a restart.\n\nReturns the refreshed system status (tier + resolved binary version) so the\ntop-bar badge updates immediately. Re-resolving may download the Pro build,\nso it runs off the event loop; the request completes when it's ready.","operationId":"update_settings_api_settings_put","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SettingsUpdate"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StatusResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/clipboard":{"post":{"summary":"Set Clipboard","description":"Push text into the VNC session's X clipboard via xclip.","operationId":"set_clipboard_api_profiles__profile_id__clipboard_post","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClipboardRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"summary":"Get Clipboard","description":"Read the VNC session's clipboard.\n\nChrome doesn't write to X11 clipboard under KasmVNC, so xclip can't read it.\nInstead, read via Playwright's CDP connection to Chrome (navigator.clipboard.readText).\nFalls back to xclip for non-Chrome clipboard owners.","operationId":"get_clipboard_api_profiles__profile_id__clipboard_get","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/cdp":{"get":{"summary":"Cdp Info","description":"Return CDP connection info. Prevents SPA catch-all from serving index.html.","operationId":"cdp_info_api_profiles__profile_id__cdp_get","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/screenshot":{"get":{"summary":"Profile Screenshot","description":"Serve the last captured browser preview (JPEG). 404 when none exists yet.","operationId":"profile_screenshot_api_profiles__profile_id__screenshot_get","parameters":[{"name":"profile_id","in":"path","required":true,"schema":{"type":"string","title":"Profile Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{profile_id}/cdp/json/version":{"get":{"summary":"Cdp Json Version","description":"Proxy Chrome's /json/version, rewriting WS URLs to go through our proxy.","operationId":"cdp_json_version_api_profiles__profile_id__cdp_j